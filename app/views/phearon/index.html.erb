


<% @characters.each do | character |%>
    <% character.name %>
<% end %>

<% @phearon.name %>



<!-- This page serves as a calculator for homebrew/complex stats -->

<div data-controller="gear"
     data-gear-data-value=<%= @phearon.to_json %>
     class="divide-y divide-gray-200 overflow-hidden rounded-lg bg-white shadow-sm">
  <div class="px-4 py-5 sm:px-6">
    <!-- Content goes here -->
    <div>
        <p data-gear-target="name">Name</p>
    </div>
    <!-- We use less vertical padding on card headers on desktop than on body sections -->
  </div>
  <div class="px-4 py-5 sm:p-6">
    <!-- Content goes here -->
    <div>
        <label for="ring1">Ring 1:</label>
        <select data-action="gear#update"
                data-gear-value-param="this.value()"
                data-gear-power-param=1
                name="ring1" id="ring1" onchange="">
           <option value='[{"value":"nil", "power":0}]'>--Please choose an option--</option> 
           <option value='[{"value":"specAbil", "power":"On command, this ring makes the wearer blink, as with the blink spell."}]'>Ring of Blinking</option>
           <option value='[{"value":"specAbil", "power":"This ring allows the caster to use the spell telekinesis on command."}]'>Ring of Telekinesis</option>
           <option value='[{"value":"deflectBonus", "power":1}]'>Ring of Protection +1</option>
           <option value='[{"value":"deflectBonus", "power":2}]'>Ring of Protection +2</option>
           <option value='[{"value":"deflectBonus", "power":3}]'>Ring of Protection +3</option>
           <option value='[{"value":"dexterity", "power":2}]'>Ring of Dexterity +2</option>
           <option value='[{"value":"dexterity", "power":2}, {"value":"specAbil", "power":"On command, this ring makes the wearer blink, as with the blink spell."}]'>Fake Ring of Dexterity +2 and Blink</option>
        </select>
    </div>

    <div>
        <label for="ring2">Ring 2:</label>
        <select data-action="gear#update" name="ring2" id="ring2" t=this.t 
                data-gear-value-param="this.value()"
                data-gear-power-param=1 >
           <option value='[{"value":"nil", "power":0}]'>--Please choose an option--</option> 
           <option value='[{"value":"specAbil", "power":"On command, this ring makes the wearer blink, as with the blink spell."}]'>Ring of Blinking</option>
           <option value='[{"value":"specAbil", "power":"This ring allows the caster to use the spell telekinesis on command."}]'>Ring of Telekinesis</option>
           <option value='[{"value":"deflectBonus", "power":1}]'>Ring of Protection +1</option>
           <option value='[{"value":"deflectBonus", "power":2}]'>Ring of Protection +2</option>
           <option value='[{"value":"deflectBonus", "power":3}]'>Ring of Protection +3</option>
           <option value='[{"value":"dexterity", "power":2}]'>Ring of Dexterity +2</option>
        </select>
    </div>


    <div>
        <label for="amulet">Amulet:</label>
        <select data-action="gear#update" name="amulet" id="amulet" t=this.t 
                data-gear-value-param="this.value()"
                data-gear-power-param=1 >
           <option value='[{"value":"nil", "power":0}]'>--Please choose an option--</option> 
           <option value='[{"value":"naturalBonus", "power":1}]'>Amulet of Natural Armor +1</option>
           <option value='[{"value":"naturalBonus", "power":2}]'>Amulet of Natural Armor +3</option>
           <option value='[{"value":"naturalBonus", "power":3}]'>Amulet of Natural Armor +3</option>
           <option value='[{"value":"dexterity", "power":2}]'>Ring of Dexterity +2</option>
        </select>
    </div>


    Weapons:

    <div>
        <label for="mainWeapon">Main Arm:</label>
        <select data-action="gear#update" name="mainWeapon" id="mainWeapon" t=this.t 
                data-gear-value-param="this.value()"
                data-gear-power-param=1 >
           <option value='[{"value":"nil", "power":0}]'>--Please choose an option--</option> 
           <option value='[{"value":"mainWeaponEnhancement", "power":1}, 
                           {"value":"mainWeaponDamageDie", "power":"1d6 slashing"}]'>Scimitar +1</option>
           <option value='[{"value":"mainWeaponEnhancement", "power":0}, 
                           {"value":"mainWeaponDamageDie", "power":"1d6 slashing + 1d6 fire"}]'>Flaming Scimitar</option>
        </select>
    </div>

    <div>
    To Hit: <p data-gear-target="mainHit"></p>
    </div>

    <div>
        <label for="sideWeapon">Side Arm:</label>
        <select data-action="gear#update" name="sideWeapon" id="sideWeapon" t=this.t 
                data-gear-value-param="this.value()"
                data-gear-power-param=1 >
           <option value='[{"value":"nil", "power":0}]'>--Please choose an option--</option> 
           <option value='[{"value":"sideWeaponEnhancement", "power":1}, 
                           {"value":"sideWeaponDamageDie", "power":"1d6 slashing"}]'>Shortsword +1</option>
           <option value='[{"value":"sideWeaponEnhancement", "power":0}, 
                           {"value":"sideWeaponDamageDie", "power":"1d6 slashing + 1d6 ice"}]'>Ice Shortsword</option>
        </select>
    </div>

    <div>
    To Hit: <p data-gear-target="sideHit"></p>
    </div>

    <div>
        <label for="hideWeapon">Hidden Arm:</label>
        <select data-action="gear#update" name="hideWeapon" id="hideWeapon" t=this.t 
                data-gear-value-param="this.value()"
                data-gear-power-param=1 >
           <option value='[{"value":"nil", "power":0}]'>--Please choose an option--</option> 
           <option value='[{"value":"hideWeaponEnhancement", "power":1}, 
                           {"value":"hideWeaponDamageDie", "power":"1d4 slashing"}]'>Dagger +1</option>
           <option value='[{"value":"hideWeaponEnhancement", "power":0}, 
                           {"value":"hideWeaponDamageDie", "power":"1d4 slashing + 1d6 ice"}]'>Ice Dagger</option>
        </select>
    </div>

    <div>
    To Hit: <p data-gear-target="hideHit"></p>
    </div>

    <div>
        <label for="longWeapon">Long Arm:</label>
        <select data-action="gear#update" name="longWeapon" id="longWeapon" t=this.t 
                data-gear-value-param="this.value()"
                data-gear-power-param=1 >
           <option value='[{"value":"nil", "power":0}]'>--Please choose an option--</option> 
           <option value='[{"value":"longWeaponEnhancement", "power":1}, 
                           {"value":"longWeaponDamageDie", "power":"1d10 piercing"}]'>Heavy Crossbow</option>
           <option value='[{"value":"longWeaponEnhancement", "power":0}, 
                           {"value":"longWeaponDamageDie", "power":"1d12 piercing"}]'>Arquebuss</option>
        </select>
    </div>

    <div>
    To Hit: <p data-gear-target="longHit"></p>
    </div>

  </div>
  <div class="px-4 py-4 sm:px-6">
    <!-- Content goes here -->
    <div data-gear-target="results">
        Strength: <p data-gear-target="str"></p>
        Dexterity: <p data-gear-target="dex"></p>
        Constitution: <p data-gear-target="con"></p>
        Intelligence: <p data-gear-target="int"></p>
        Wisdom: <p data-gear-target="wis"></p>
        Charisma: <p data-gear-target="cha"></p>

        Armor Class <p data-gear-target="AC"></p>

       
        Spcial Abilities: <p data-gear-target="specAbil"></p>
    </div>
    <!-- We use less vertical padding on card footers at all sizes than on headers or body sections -->
  </div>
</div>

