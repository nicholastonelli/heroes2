<div id="characterCard">
    <% character %>
        <table class="">
            <tbody class="">
                <tr class="">
                    <th class="">Size/Type: 
                    </th> 
                    <td class=""> Medium Human
                    </td>
                </tr>

                <tr class="">
                    <th class="">Hit Dice: 
                    </th> 
                    <td> <%= character.level %>d6 + <%= ((character.constitution-10)/2) * character.level %>  (<%= character.health %>)
                    </td>
                </tr>

                <tr>
                    <th>Initiative: 
                    </th> 
                    <td> +<%= (character.dexterity-10)/2 %>
                    </td>
                </tr>

                <tr>
                    <th>Speed: 
                    </th> 
                    <td> 30 ft.
                    </td>
                </tr>

                <tr>
                    <th>Armor Class: 
                    </th> 
                    <td data-attack-target='AC'> 
                    </td>
                </tr>

                <tr>
                    <th>Base Attack/Grapple: 
                    </th> 
                    <td data-attack-target='bab'> 
                    </td>
                </tr>

                <tr>
                    <th>Full Attack: 
                    </th> 
                    <td data-attack-target='fullHit'> 
                    </td>
                </tr>

                <tr>
                    <th>Side Attack: 
                    </th> 
                    <td data-attack-target='sideHit'> 
                    </td>
                </tr>

                <tr>
                    <th>Hidden Attack: 
                    </th> 
                    <td data-attack-target='hideHit'> 
                    </td>
                </tr>

                <tr>
                    <th>Long Attack: 
                    </th> 
                    <td data-attack-target='longHit'> 
                    </td>
                </tr>


                <tr>
                    <th>Sneak Attack: 
                    </th> 
                    <td data-attack-target='sneakDice'> 
                    </td>
                </tr>

                <tr>
                    <th>Special Abilities: 
                    </th> 
                    <td data-attack-target='specAbil'> 
                    </td>
                </tr>

                <tr>
                    <th>Saves: 
                    </th> 
                    <td data-attack-target='saves'> Fort , Ref , Will 
                    </td>
                </tr>

                <tr>
                    <th>Abilities: 
                    </th> 
                    <td data-attack-target='abil'> 
                    </td>
                </tr>

                <tr>
                    <th>Skills: 
                    </th> 
                    <td data-attack-target='skills'> 
                    </td>
                </tr>
        </table>
    </div>